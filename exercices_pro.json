      "tts": {
        "voice_hint": "fr-FR",
        "script_short": [
          "Pieds au sol.",
          "Appuie doucement, sens le contact.",
          "Relâche. Recommence 5 fois.",
          "Ajoute une expiration longue."
        ],
        "script_long": [
          "Assis ou debout, pieds bien posés.",
          "Appuie dans le sol 3 secondes, relâche 3 secondes.",
          "Répète 10 fois. Ton corps revient ici."
        ]
      },
      "variants": {
        "short": { "duration_sec": 60, "steps": ["Pression/relâche x5", "2 expirations longues"] },
        "long": { "duration_sec": 180, "steps": ["Pression/relâche x10", "Respiration 4–6"] }
      }
