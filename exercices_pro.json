    {
      "id": "breath_4_6",
      "title": "Respiration 4–6 (apaisement)",
      "modality": "respiration",
      "level": "debutant",
      "domains": ["stress", "anxiete", "panique", "surcharge_mentale", "sommeil"],
      "tags": ["calme", "anti-panique", "regulation", "rapide"],
      "contraindications": ["Si vertiges: réduire amplitude, respirer plus naturellement."],
      "equipment": [],
      "media": { "preview_mp4": "media/exercices/breath_4_6_preview.mp4", "poster": "media/exercices/breath_4_6_poster.jpg" },
      "tts": {
        "lang": "fr-FR",
        "scripts": {
          "micro": ["Assieds-toi. Inspire 4 secondes. Expire 6 secondes. Répète, sans forcer."],
          "court": ["Inspire 4… expire 6… relâche épaules. Continue tranquillement."],
          "moyen": ["Reste sur 4–6. À chaque expiration, détends la mâchoire. Reviens au souffle."],
          "long": ["On stabilise. Souffle doux, long, régulier. Si pensées: 'je reviens au 4–6'."]
        }
      },
      "variants": {
        "micro": { "duration_sec": 60, "steps": ["4s inspire", "6s expire", "1 minute"] },
        "court": { "duration_sec": 180, "steps": ["4s inspire", "6s expire", "3 minutes"] },
        "moyen": { "duration_sec": 360, "steps": ["4–6 stable", "6 minutes"] },
        "long": { "duration_sec": 600, "steps": ["4–6 stable", "10 minutes"] }
      }
    },

